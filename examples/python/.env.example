# Copy to .env and load before running scripts (or export manually)

MULTILOGIN_BASE_URL=http://127.0.0.1:35000
MULTILOGIN_TOKEN=your-automation-token-here
MULTILOGIN_PROFILE_ID=your-profile-uuid-here

